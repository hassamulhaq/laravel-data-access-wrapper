{
    "name": "hassam/data-access-wrapper",
    "description": "Scalable entity + ID-list caching layer for Laravel Eloquent models and repositories.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "data-access", "wrapper", "repository", "cache", "eloquent"],
    "authors": [
        {
            "name": "hassamulhaq",
            "email": "developer.hassam@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Hassam\\DataAccessWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hassam\\DataAccessWrapper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hassam\\DataAccessWrapper\\DataAccessWrapperServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
